# Environment

# --- Mode ---------------------------------------------------------------
# demo   → runs fully in-memory with seeded BIGGY~LINHO data (NOV13-24).
#          Zero external services required. Ideal for first run / preview.
# prod   → switches to Prisma (PostgreSQL) + Supabase auth + storage.
NEXT_PUBLIC_APP_MODE=demo

# --- Database (Prisma / PostgreSQL) -------------------------------------
# Only needed when NEXT_PUBLIC_APP_MODE=prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/us
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/us

# --- Supabase (auth + storage) -------------------------------------------
# Only needed when NEXT_PUBLIC_APP_MODE=prod
#   NEXT_PUBLIC_SUPABASE_URL        Project URL (Settings → API)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   Project anon/public key
#   SUPABASE_SERVICE_ROLE_KEY       Service role key (secret — server only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=us-media

# --- Session -------------------------------------------------------------
# Used to sign demo-mode session cookies. Generate via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=demo-session-secret-change-me

# --- App -----------------------------------------------------------------
# Base URL used to build password-reset redirect links in prod mode
# (/auth/update-password). Local dev runs on port 3005.
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Environment

# --- Mode ---------------------------------------------------------------
# demo   → runs fully in-memory with seeded demo data (Alex & Maya).
#          Zero external services required. Ideal for first run / preview.
# prod   → switches to Prisma (PostgreSQL) + Supabase auth + storage.
NEXT_PUBLIC_APP_MODE=demo

# --- Database (Prisma / PostgreSQL) -------------------------------------
# Only needed when NEXT_PUBLIC_APP_MODE=prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/us
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/us

# --- Supabase (auth + storage) -------------------------------------------
# Only needed when NEXT_PUBLIC_APP_MODE=prod
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=us-media

# --- Session -------------------------------------------------------------
# Used to sign demo-mode session cookies. Generate via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=demo-session-secret-change-me

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
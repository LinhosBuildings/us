// US — production data blueprint (PostgreSQL via Supabase)
// Mirrors src/lib/types.ts. Demo mode uses an in-memory store; this schema is
// the "prod" target. Enable with NEXT_PUBLIC_APP_MODE=prod.
//
// The relationship boundary is enforced here at the storage layer:
// every model carries relationshipId, and joins are always through it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String?
  avatarUrl          String?
  whatsapp           String?
  github             String?
  instagram          String?
  relationshipId     String?
  relationship       Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  memoriesCreated    Memory[]
  letters            Letter[]
  openWhen           OpenWhen[]
  confessions        Confession[]
  dictionary         DictionaryEntry[]
  littleThings       LittleThing[]
  firsts             FirstRecord[]
  goals              FutureGoal[]
  reflections        Reflection[]
  survived           SurvivedEntry[]
  perspectives       Perspective[]
  messages           Message[]

  @@index([relationshipId])
}

model Relationship {
  id             String   @id @default(cuid())
  code           String   @unique
  secretCode     String   @unique
  name           String
  title          String?
  description    String?
  startDate      DateTime
  coverImageUrl  String?
  createdAt      DateTime @default(now())

  members        RelationshipMember[]
  memories       Memory[]
  chapters       Chapter[]
  letters        Letter[]
  openWhen       OpenWhen[]
  confessions    Confession[]
  dictionary     DictionaryEntry[]
  littleThings   LittleThing[]
  firsts         FirstRecord[]
  places         Place[]
  soundtrack     SoundtrackSong[]
  goals          FutureGoal[]
  capsules       TimeCapsule[]
  reflections    Reflection[]
  survived       SurvivedEntry[]
  mediaAssets    MediaAsset[]
  messages       Message[]

  @@index([code])
}

model RelationshipMember {
  relationshipId String
  userId         String
  isOwner        Boolean
  joinedAt       DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@id([relationshipId, userId])
}

model MediaAsset {
  id            String   @id @default(cuid())
  relationshipId String
  type          String // image | video | audio
  url           String
  thumbnailUrl  String?
  width         Int?
  height        Int?
  durationMs    Int?
  mime          String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  memories      MemoryMedia[]
  letters       LetterMedia[]
  openWhen      OpenWhenMedia[]
  confessions   ConfessionMedia[]
  littleThings  LittleThingMedia[]
  capsuleMedia  TimeCapsuleMedia[]

  @@index([relationshipId])
}

// ── Memories ──────────────────────────────────────────────────

model Memory {
  id               String     @id @default(cuid())
  relationshipId   String
  title            String
  kind             String
  date             DateTime
  description      String     @default("")
  locationName     String?
  mood             String?
  people           String[]   @default([])
  tags             String[]   @default([])
  visibility       String     @default("both")
  neverTold        String?
  constellationX   Float?
  constellationY   Float?
  chapterId        String?
  milestoneLabel   String?
  milestoneCategory String?
  status           String? // verified | needs-confirmation | incomplete
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // song (denormalized, nullable single)
  songTitle        String?
  songArtist       String?
  songExternalUrl  String?

  createdBy        String
  author           User       @relation(fields: [createdBy], references: [id])
  relationship     Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  chapter          Chapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  media            MemoryMedia[]
  perspectives     Perspective[]

  @@index([relationshipId, date])
  @@index([createdBy])
}

model MemoryMedia {
  memoryId String
  mediaId  String
  memory   Memory  @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([memoryId, mediaId])
}

model Perspective {
  id             String @id @default(cuid())
  memoryId       String
  authorId       String
  authorName     String
  text           String
  createdAt      DateTime @default(now())
  memory         Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  author         User   @relation(fields: [authorId], references: [id])

  @@index([memoryId])
}

model Chapter {
  id             String   @id @default(cuid())
  relationshipId String
  order          Int
  code           String
  title          String
  epigraph       String?
  intro          String?
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  memories       Memory[]

  @@unique([relationshipId, code])
  @@unique([relationshipId, order])
}

// ── Expressions: letters, open-when, confessions ───────────────

model Letter {
  id             String  @id @default(cuid())
  relationshipId String
  authorId       String
  title          String
  category       String
  body           String
  lockAt         DateTime?
  createdAt      DateTime @default(now())
  author         User   @relation(fields: [authorId], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media          LetterMedia[]

  @@index([relationshipId, createdAt])
}

model LetterMedia {
  letterId String
  mediaId  String
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([letterId, mediaId])
}

model OpenWhen {
  id               String  @id @default(cuid())
  relationshipId   String
  authorId         String
  title            String
  body             String
  lockBehavior     String
  unlockAt         DateTime?
  interactionHint  String?
  locked           Boolean @default(true)
  createdAt        DateTime @default(now())
  author           User    @relation(fields: [authorId], references: [id])
  relationship     Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media            OpenWhenMedia[]

  @@index([relationshipId])
}

model OpenWhenMedia {
  entryId String
  mediaId String
  entry   OpenWhen @relation(fields: [entryId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([entryId, mediaId])
}

model Confession {
  id             String  @id @default(cuid())
  relationshipId String
  authorId       String
  text           String
  visibility     String
  revealAt       DateTime?
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [authorId], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media          ConfessionMedia[]

  @@index([relationshipId])
}

model ConfessionMedia {
  confessionId String
  mediaId      String
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([confessionId, mediaId])
}

// ── World: dictionary, little things, firsts, places, soundtrack ─

model DictionaryEntry {
  id             String @id @default(cuid())
  relationshipId String
  word           String
  meaning        String
  inventorId     String?
  inventorName   String?
  origin         String?
  example        String?
  usedSince      String?
  audioId        String?
  createdAt      DateTime @default(now())
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, word])
  @@index([relationshipId])
}

model LittleThing {
  id             String  @id @default(cuid())
  relationshipId String
  authorId       String
  what           String
  why            String?
  date           DateTime?
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [authorId], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media          LittleThingMedia[]

  @@index([relationshipId])
}

model LittleThingMedia {
  thingId String
  mediaId String
  thing   LittleThing @relation(fields: [thingId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([thingId, mediaId])
}

model FirstRecord {
  id             String  @id @default(cuid())
  relationshipId String
  title          String
  date           DateTime?
  description    String?
  imageUrl       String?
  createdBy      String
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [createdBy], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}

model Place {
  id             String  @id @default(cuid())
  relationshipId String
  name           String
  latitude       Float
  longitude      Float
  date           DateTime?
  story          String?
  memoryIds      String[] @default([])
  createdAt      DateTime @default(now())
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}

model SoundtrackSong {
  id             String  @id @default(cuid())
  relationshipId String
  title          String
  artist         String
  externalUrl    String?
  memoryTitle    String?
  why            String?
  date           DateTime?
  createdAt      DateTime @default(now())
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}

// ── Future: goals, time capsules ──────────────────────────────

model FutureGoal {
  id             String  @id @default(cuid())
  relationshipId String
  title          String
  description    String?
  category       String
  targetDate     DateTime?
  progress       Int     @default(0)
  imageUrl       String?
  completed      Boolean @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [createdBy], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}

model TimeCapsule {
  id             String    @id @default(cuid())
  relationshipId String
  title          String
  note           String?
  unlockAt       DateTime
  questions      String[]  @default([])
  predictions    String[]  @default([])
  status         String    @default("sealed")
  openedAt       DateTime?
  createdAt      DateTime  @default(now())
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media          TimeCapsuleMedia[]

  @@index([relationshipId])
}

model TimeCapsuleMedia {
  capsuleId String
  mediaId   String
  capsule   TimeCapsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([capsuleId, mediaId])
}

// ── Reflections & survived ────────────────────────────────────

model Message {
  id             String @id @default(cuid())
  relationshipId String
  authorId       String
  authorName     String
  body           String
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [authorId], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId, createdAt])
}

model Reflection {
  id             String @id @default(cuid())
  relationshipId String
  question       String
  answer         String
  authorId       String
  authorName     String
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [authorId], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}

model SurvivedEntry {
  id             String  @id @default(cuid())
  relationshipId String
  whatHappened   String
  howIFelt       String?
  whatILearned   String?
  howWeResolved  String?
  doNotForget    String?
  resolved       Boolean @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  author         User    @relation(fields: [createdBy], references: [id])
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
}